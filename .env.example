# Real Estate Scout environment variables
#
# Copy this file to `.env` (ETL) and/or `web/.env.local` (web)
# and fill in the values. Do not commit real secrets.

# --- Shared database (used by ETL) ---
DB_HOST=192.168.1.57
DB_PORT=5432
DB_NAME=real_estate_scout
DB_USER=realestatescoutagent
DB_PASSWORD=changeme

# --- Web dashboard (Next.js) ---
# The web app expects a single DATABASE_URL.
DATABASE_URL=postgresql://realestatescoutagent:changeme@192.168.1.57:5432/real_estate_scout
